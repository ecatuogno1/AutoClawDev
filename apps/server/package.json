{
  "name": "@autoclawdev/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "test": "tsx --test tests/**/*.test.ts",
    "test:browser": "tsx --test tests/historyBrowser.test.ts",
    "typecheck": "tsc --noEmit",
    "build": "pnpm --filter @autoclawdev/types build && tsc",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "@autoclawdev/types": "workspace:*",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "ws": "^8.20.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.15.3",
    "@types/ws": "^8.18.1",
    "playwright": "^1.58.2",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3"
  }
}
